{
  "rewrites": [
    { "source": "/demo-plan.html", "destination": "/demo-plan.html" },
    { "source": "/admin-vocab.html", "destination": "/admin-vocab.html" },
    { "source": "/admin-withdrawal.html", "destination": "/admin-withdrawal.html" },
    { "source": "/book-lesson.html", "destination": "/book-lesson.html" },
